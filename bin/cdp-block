#!/usr/bin/env python3
"""cdp-block — block trackers/analytics via CDP Network.setBlockedURLs.

Usage: cdp-block <tab-id-prefix>
Blocks common tracker/analytics/ad domains on the given tab.
"""
import json
import sys
import urllib.request
from websocket import create_connection

BLOCKED = [
    "*google-analytics.com*",
    "*googletagmanager.com*",
    "*googletagservices.com*",
    "*doubleclick.net*",
    "*facebook.net*",
    "*connect.facebook.net*",
    "*hotjar.com*",
    "*mixpanel.com*",
    "*segment.com",
    "*segment.io*",
    "*amplitude.com*",
    "*fullstory.com*",
    "*intercom.io*",
    "*drift.com*",
    "*hubspot.com*",
    "*marketo.net*",
    "*pardot.com*",
    "*adservice.google.com*",
    "*ads.yahoo.com*",
    "*criteo.com*",
    "*outbrain.com*",
    "*taboola.com*",
]

def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return
    prefix = sys.argv[1]
    with urllib.request.urlopen("http://127.0.0.1:9222/json/list", timeout=5) as r:
        targets = json.loads(r.read())
    page = next((t for t in targets if t["id"].startswith(prefix)), None)
    if not page:
        print(f"no tab matching {prefix}")
        return
    ws = create_connection(page["webSocketDebuggerUrl"], timeout=10)
    ws.send(json.dumps({"id": 1, "method": "Network.setBlockedURLs", "params": {"urls": BLOCKED}}))
    print("block response:", ws.recv()[:80])
    ws.send(json.dumps({"id": 2, "method": "Page.reload", "params": {}}))
    print("reloaded")
    ws.close()

if __name__ == "__main__":
    main()
